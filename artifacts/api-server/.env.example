# ── ZARITH API SERVER — Variáveis de Ambiente (Render) ───────────────────────
# Copie este arquivo como .env para desenvolvimento local.
# No Render: configure cada variável no painel Environment > Environment Variables.

# ── Banco de dados ────────────────────────────────────────────────────────────
# Render PostgreSQL: Environment > Databases → copie a Internal Connection String
# Alternativa gratuita: https://neon.tech (sem expiração)
DATABASE_URL=postgresql://user:password@host:5432/zarith

# ── Modelos de IA ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...              # CORE PRINCIPAL — https://aistudio.google.com
ANTHROPIC_API_KEY=sk-ant-...       # Fallback #1   — https://console.anthropic.com
OPENAI_API_KEY=sk-...              # Fallback #2   — https://platform.openai.com
GROQ_API_KEY=gsk_...               # Fallback #3   — https://console.groq.com

# ── GitHub (self-coding) ──────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...               # PAT com permissão repo → https://github.com/settings/tokens

# ── Voice (ElevenLabs) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...             # https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # ID da voz padrão

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL do frontend na Vercel (sem barra no final)
CORS_ORIGIN=https://zarith-super-agente-zarith.vercel.app

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
